{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run -q --release --offline --manifest-path \"${CLAUDE_PROJECT_DIR}/tools/tidy/Cargo.toml\" -- hook 2>/dev/null || true",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
